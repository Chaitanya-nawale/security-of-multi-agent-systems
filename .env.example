# API key for the LLM endpoint (use "EMPTY" or "not-needed" if self-hosted without auth)
OPENAI_API_KEY="EMPTY"

# Base URL for the OpenAI-compatible server (include /v1)
# For vLLM: http://localhost:8000/v1
# For Ollama: http://localhost:11434/v1
# For OpenAI: https://api.openai.com/v1
OPENAI_API_BASE="http://localhost:8000/v1"

# Model identifier hosted on the server
LLM_MODEL="Qwen 3.8 27B"

#(Optional) Langfuse Tracing Configuration
# Pre-configured to work out-of-the-box with the local self-hosted docker compose setup:
LANGFUSE_PUBLIC_KEY="pk-lf-local-mas"
LANGFUSE_SECRET_KEY="sk-lf-local-mas"
LANGFUSE_BASE_URL="http://localhost:3000"

# (Optional) For Langfuse Cloud instead:
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# (Optional for experimentation)
LLM_MAX_TOKENS="800"
